								"type": "SqlServerSource",
								"sqlReaderQuery": {
									"value": "@concat(\n'SELECT\n    __$start_lsn,\n    __$seqval,\n    __$operation,\n    customer_id,\n    first_name,\n    last_name,\n    date_of_birth,\n    gender,\n    city,\n    postcode,\n    email,\n    phone_number,\n    join_date,\n    customer_status\nFROM cdc.fn_cdc_get_all_changes_dbo_customers(\n    sys.fn_cdc_increment_lsn(CONVERT(binary(10), ''',\nactivity('Lookup_Last_LSN').output.firstRow.last_lsn,\n''', 1)),\n    CONVERT(binary(10), ''',\nactivity('Lookup_Current_Max_LSN').output.firstRow.current_max_lsn,\n''', 1),\n    ''all update old''\n);'\n)",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
