					{
						"name": "Lookup_Last_LSN",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": "-- Read the last successfully processed CDC LSN for customers.\n-- We convert BINARY(10) to a hexadecimal string because\n-- ADF handles the value more easily as text.\n\nSELECT\n    sys.fn_varbintohexstr(last_lsn) AS last_lsn\nFROM dbo.cdc_watermark\nWHERE table_name = 'customers';",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_Customers_EE",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "Lookup_Current_Max_LSN",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "Lookup_Last_LSN",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": "-- Get the current highest CDC Log Sequence Number (LSN).\n-- This becomes the END boundary for this particular CDC run.\n-- Any changes occurring after this LSN will be handled by a future run.\n\nSELECT\n    sys.fn_varbintohexstr(sys.fn_cdc_get_max_lsn()) AS current_max_lsn;",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_Customers_EE",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "Update_Customers_Watermark",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "Copy_Customers_CDC",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[usp_update_cdc_watermark]",
							"storedProcedureParameters": {
								"new_lsn": {
									"value": {
										"value": "@activity('Lookup_Current_Max_LSN').output.firstRow.current_max_lsn",
										"type": "Expression"
									},
									"type": "String"
								},
								"table_name": {
									"value": "customers",
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_SQLServer_EETelecom",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
