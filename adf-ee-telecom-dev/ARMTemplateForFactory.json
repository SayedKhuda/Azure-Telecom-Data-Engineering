											"name": "__$start_lsn",
											"type": "Byte[]",
											"physicalType": "BINARY"
										}
									},
									{
										"source": {
											"name": "__$seqval",
											"type": "Byte[]",
											"physicalType": "binary"
										},
										"sink": {
											"name": "__$seqval",
											"type": "Byte[]",
